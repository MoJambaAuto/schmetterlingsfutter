{
  // Schmetterlingsfutter-Relay: Partner-Verbindung (Cloudflare Worker + D1, kostenloser Tarif)
  // Veröffentlichen: siehe relay/README.md
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "schmetterlingsfutter-relay",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  "triggers": { "crons": ["20 4 * * *"] },
  "vars": {
    "ALLOWED_ORIGINS": "https://mojambaauto.github.io,http://localhost:8787,http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "schmetterlingsfutter",
      // angelegt am 10.11.2026 mit `wrangler d1 create schmetterlingsfutter --jurisdiction eu` (Konto mojamba.automation)
      "database_id": "6f04ade0-c92e-489e-bf97-6c3dbdb96f79",
      "migrations_dir": "migrations"
    }
  ]
}
