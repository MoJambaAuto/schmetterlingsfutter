  "bis": 11.23,
  "kb": 52
 },
 {
  "id": "s-einfachso-3",
  "cat": "einfachso",
  "text": "Kleiner Gruß, großes Herz, für dich!",
  "stil": "Retro-Gesangsgruppe mit Bläsern",
  "sek": 6,
  "suno": "81ca71b0-ac5f-4eb9-a6d7-42e01373d615",
  "von": 11.24,
