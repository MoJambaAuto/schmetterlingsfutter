  "kb": 73
 },
 {
  "id": "s-streit-2",
  "cat": "streit",
  "text": "Weiße Fahne, Schatz! Vertragen wir uns?",
  "stil": "A cappella, Doo-wop",
  "sek": 5.3,
  "suno": "009bb59a-5d79-44c6-9659-86570ceeb8d1",
