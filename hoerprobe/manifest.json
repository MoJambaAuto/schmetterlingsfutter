[
 {
  "id": "s-einfachso-1",
  "cat": "einfachso",
  "text": "Nur mal so zwischendurch: Ich lieb dich!",
  "stil": "Retro-Gesangsgruppe mit Bläsern",
  "sek": 4.8,
  "suno": "81ca71b0-ac5f-4eb9-a6d7-42e01373d615",
