  "kb": 66
 },
 {
  "id": "s-einfachso-2",
  "cat": "einfachso",
  "text": "Mittendrin am Tag ein Gruß von mir.",
  "stil": "Retro-Gesangsgruppe mit Bläsern",
  "sek": 3.8,
  "suno": "81ca71b0-ac5f-4eb9-a6d7-42e01373d615",
